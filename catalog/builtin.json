      "method": "GET", "path": "/d2l/api/le/{version}/{orgUnitId}/quizzes/{quizId}", "pathParameters": ["orgUnitId", "quizId"], "apiFamily": "le", "versions": { "min": "1.82", "max": "1.98" },
