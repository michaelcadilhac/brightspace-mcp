    },
    {
      "id": "quizzes.update", "resource": "quizzes", "description": "Replace quiz properties using an explicit QuizData body. NumberOfAttemptsAllowed is a top-level field.",
      "method": "PUT", "path": "/d2l/api/le/{version}/{orgUnitId}/quizzes/{quizId}", "pathParameters": ["orgUnitId", "quizId"], "apiFamily": "le", "versions": { "min": "1.82", "max": "1.98" },
      "semantics": "write", "support": "documented", "sources": ["https://docs.valence.desire2learn.com/res/quiz.html"], "updateBehavior": "replace", "schemaKnowledge": "partial",
      "requestSchema": { "type": "object", "additionalProperties": true, "properties": { "Name": { "type": "string" }, "IsActive": { "type": "boolean" }, "NumberOfAttemptsAllowed": { "type": ["integer", "null"] } }, "not": { "required": ["AttemptsAllowed"] } },
      "limitations": ["Schema is structural only; complete QuizData field requirements and version-specific additions require caller review.", "Finite NumberOfAttemptsAllowed must be 1..10 in the documented contract. A legacy zero can be attempted for preservation; only an attributed definitive API rejection permits a caller-authorized omission/default retry.", "Null means unlimited attempts. Omission can reset fields and is not a preservation guarantee.", "No automatic quiz read-to-write serializer is claimed, because protected and rich-text fields require complete contract knowledge."]
    },
